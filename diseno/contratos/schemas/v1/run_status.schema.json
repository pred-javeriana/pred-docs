{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pred-contrato/v1/run_status.schema.json",
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "description": "Si el dato existe hoy. Sostiene estados vacios y acciones deshabilitadas.",
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "no_data",
                "not_implemented",
                "stage_not_implemented",
                "prerequisite_missing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "blocked_by": {
          "items": {
            "pattern": "^G[1-8]$",
            "type": "string"
          },
          "title": "Blocked By",
          "type": "array"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "status"
      ],
      "title": "Availability",
      "type": "object"
    },
    "Ejecucion": {
      "additionalProperties": false,
      "description": "Fila de `ejecuciones`.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "ingest_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ingest Id"
        },
        "configuracion_id": {
          "title": "Configuracion Id",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "estado": {
          "enum": [
            "pendiente",
            "ejecutando",
            "completada",
            "completada_con_fallos",
            "detenida"
          ],
          "title": "Estado",
          "type": "string"
        },
        "iniciada_en": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iniciada En"
        },
        "finalizada_en": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finalizada En"
        }
      },
      "required": [
        "id",
        "configuracion_id",
        "seed",
        "estado"
      ],
      "title": "Ejecucion",
      "type": "object"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "Error normalizado. `code` es el que se persiste en `bitacora_calidad.codigo`.",
      "properties": {
        "code": {
          "pattern": "^[a-z_]+\\.[a-z_]+$",
          "title": "Code",
          "type": "string"
        },
        "stage": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "platform"
          ],
          "title": "Stage",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "info",
            "advertencia",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "source_exception": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Exception"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "stage"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "size": {
          "maximum": 500,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "number",
        "size",
        "total"
      ],
      "title": "Page",
      "type": "object"
    },
    "Progress": {
      "additionalProperties": false,
      "properties": {
        "tareas_total": {
          "minimum": 0,
          "title": "Tareas Total",
          "type": "integer"
        },
        "tareas_por_estado": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "pendiente",
              "ejecutando",
              "exitosa",
              "fallida",
              "no_ejecutable"
            ]
          },
          "title": "Tareas Por Estado",
          "type": "object"
        },
        "avance_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Avance Pct",
          "type": "number"
        }
      },
      "required": [
        "tareas_total",
        "tareas_por_estado",
        "avance_pct"
      ],
      "title": "Progress",
      "type": "object"
    },
    "RunSettings": {
      "additionalProperties": false,
      "description": "Contenido de `configuraciones.parametros` que la interfaz necesita mostrar.",
      "properties": {
        "configuracion_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuracion Version"
        },
        "families": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "classical",
                  "ml",
                  "dl",
                  "foundation"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Families"
        },
        "policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Version"
        },
        "min_train": {
          "minimum": 1,
          "title": "Min Train",
          "type": "integer"
        },
        "horizon": {
          "minimum": 1,
          "title": "Horizon",
          "type": "integer"
        },
        "step": {
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        },
        "metric": {
          "enum": [
            "mae",
            "rmse",
            "smape",
            "mase"
          ],
          "title": "Metric",
          "type": "string"
        },
        "seasonality": {
          "minimum": 1,
          "title": "Seasonality",
          "type": "integer"
        },
        "aggregation": {
          "enum": [
            "media",
            "mediana",
            "media_recortada"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "trim": {
          "exclusiveMaximum": 0.5,
          "minimum": 0,
          "title": "Trim",
          "type": "number"
        }
      },
      "required": [
        "min_train",
        "horizon",
        "step",
        "metric",
        "seasonality",
        "aggregation",
        "trim"
      ],
      "title": "RunSettings",
      "type": "object"
    },
    "Tarea": {
      "additionalProperties": false,
      "description": "Fila de `tareas`: una por SKU x modelo x corte.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "sku": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sku"
        },
        "modelo": {
          "minLength": 1,
          "title": "Modelo",
          "type": "string"
        },
        "family": {
          "anyOf": [
            {
              "enum": [
                "classical",
                "ml",
                "dl",
                "foundation"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family"
        },
        "corte": {
          "minLength": 1,
          "title": "Corte",
          "type": "string"
        },
        "estado": {
          "enum": [
            "pendiente",
            "ejecutando",
            "exitosa",
            "fallida",
            "no_ejecutable"
          ],
          "title": "Estado",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "tiempo_pared_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tiempo Pared S"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "iniciada_en": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iniciada En"
        },
        "finalizada_en": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finalizada En"
        }
      },
      "required": [
        "id",
        "modelo",
        "corte",
        "estado",
        "seed"
      ],
      "title": "Tarea",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "source": {
      "enum": [
        "dal",
        "fixture"
      ],
      "title": "Source",
      "type": "string"
    },
    "availability": {
      "$ref": "#/$defs/Availability"
    },
    "ejecucion": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ejecucion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "settings": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/Progress"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/Tarea"
      },
      "title": "Tasks",
      "type": "array"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/Page"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "availability",
    "tasks"
  ],
  "title": "RunStatus",
  "type": "object",
  "x-contract-version": "1.0.0"
}
