@startuml
!include <c4/C4_Component>
LAYOUT_TOP_DOWN()
UpdateElementStyle("component", $bgColor="#b9d9ef", $fontColor="#14324d", $borderColor="#225580")
UpdateElementStyle("container", $bgColor="#d7e7f5", $fontColor="#14324d", $borderColor="#225580")
skinparam backgroundColor white
skinparam shadowing false
skinparam legendFontColor #172b3d
skinparam legendFontSize 14
skinparam legendBackgroundColor #f7f9fb
skinparam legendBorderColor #aab7c2
title Diagrama de componentes del ejecutor de tareas de PRED

Container(m0, "M0 · Generador sintético", "Container: Python, pred-engine-fase0", "Produce CSV reproducible cuando se solicita")
Container_Boundary(ejecutor, "Ejecutor de tareas") {
    Component(m1, "M1 · Ingesta", "Component: Python, pred-engine", "Valida históricos y publica el panel clasificado")
    Component(m2, "M2 · Selección", "Component: Python, pred-engine", "Optimiza configuraciones y entrega candidatos")
    Component(m3, "M3 · Evaluación final", "Component: Python, pred-engine", "Evalúa la reserva y selecciona por categoría")
    Component(m4, "M4 · Síntesis", "Component: Python, pred-engine", "Presenta evidencia y exporta informes sin recalcular métricas")
}
ContainerDb(base, "Base operativa y evidencia", "Container: SQLite", "Guarda métricas, selección y veredictos por corrida")
Container(archivos, "Archivos analíticos", "Container: CSV, Parquet, JSON/JSONL", "Guarda históricos, paneles, puntos de control e informes")

Rel_R(m0, m1, "Aporta datos opcionales", "Archivo CSV local")
Rel_D(m1, m2, "Entrega panel clasificado", "Archivo Parquet local")
Rel_D(m2, m3, "Entrega candidatos y reserva", "Llamada Python")
Rel_L(m3, m4, "Habilita la síntesis al publicar", "SQLite local")
m1 -[norank]-> archivos : <b>Lee CSV y publica Parquet</b>\n<i>[Sistema de archivos]</i>
m3 -[norank]-> base : <b>Guarda métricas y veredictos</b>\n<i>[SQLite local]</i>
m4 -[norank]-> base : <b>Lee evidencia publicada</b>\n<i>[SQLite local]</i>
m4 -[norank]-> archivos : <b>Exporta informes</b>\n<i>[Sistema de archivos]</i>

legend bottom
|= Notación |= Significado |
| [Component: tecnología] | Módulo dentro del ejecutor. Azul intenso. |
| [Container: tecnología] | Aplicación o almacén externo al ejecutor. Azul claro. |
| Límite discontinuo | Componentes del contenedor Ejecutor de tareas. |
| Flecha continua | Relación dirigida; etiqueta superior: acción; inferior: tecnología. |
| PRED; M0-M4 | Plataforma de Evaluación y Recomendación de modelos de Demanda; módulos numerados. |
| CSV; JSON/JSONL | Valores separados por comas; datos JSON y JSON por líneas. |
endlegend
@enduml
